---
import { languages } from '@/i18n/ui';
import { getLangFromUrl } from '@/i18n/utils';
import ChevronDownIcon from '../assets/svg/chevron_down.svg';

const currentLang = getLangFromUrl(Astro.url);
---

<div class="text-primary-gray group relative">
  <input type="checkbox" id="menu-toggle" class="peer hidden" />
  <label for="menu-toggle" class="flex transform cursor-pointer items-center justify-between">
    <span class="uppercase">{currentLang}</span>
    <ChevronDownIcon width={24} height={24} />
  </label>

  <div
    class="absolute top-full right-0 z-50 max-h-0 min-w-16 overflow-hidden text-center transition-all duration-300 group-hover:max-h-60 peer-checked:max-h-60"
  >
    <ul class="flex flex-col p-1">
      {
        Object.entries(languages).map(([lang]) => (
          <li>
            <a
              href={`/${lang === 'en' ? '' : lang}`}
              class={`hover:bg-primary-gray block p-2 uppercase ${currentLang === lang ? 'font-bold text-white' : ''}`}
            >
              {lang}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
