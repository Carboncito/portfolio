---
import SectionLayout from '@/layouts/SectionLayout.astro';
import BlockTable from '../BlockTable.astro';
import SectionTitle from '../SectionTitle.astro';

const TITLE = 'skills';
const languages = ['JavaScript', 'TypeScript', 'Java', 'Kotlin'];
const mobile = ['React Native', 'Expo', 'iOS/Android'];
const frontend = [
  'React',
  'Next.js',
  'Angular',
  'Zustand',
  'Redux',
  'TailwindCSS',
  'NativeWind',
  'Styled Components',
  'Storybook',
  'Jest',
];
const backend = ['Node.js', 'Express', 'NestJS', 'MySQL', 'PostgreSQL', 'MongoDB', 'GraphQL'];
---

<SectionLayout id={TITLE}>
  <SectionTitle title={TITLE} />
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-6 sm:grid-cols-3 sm:justify-items-center xl:grid-cols-4">
      <BlockTable title="Languages" items={languages} />
      <BlockTable title="Mobile" items={mobile} />
      <BlockTable title="Frontend" items={frontend} />
      <BlockTable title="Backend" items={backend} />
    </div>
  </div>
</SectionLayout>
