---
import Button from '../Button.astro';
import ChevronDown from '../../assets/svg/chevron_down.svg';
import Rectangle from '../Rectangle.astro';
---

<section class="flex min-h-screen items-center justify-center">
  <div class="flex flex-col text-center sm:w-[34rem]">
    <h1 class="text-3xl font-semibold">
      Hi, I'm Jonathan a <span class="text-primary">mobile</span> and <span class="text-primary"
        >front-end developer</span
      >
    </h1>
    <p class="text-primary-gray mt-4 text-lg">
      I create beautiful and functional digital experiences that engage users and drive results.
    </p>
    <Button class="hidden self-center sm:block">Contact me!!</Button>
  </div>
  <div class="absolute bottom-8 animate-bounce">
    <ChevronDown class="h-6 w-6" />
  </div>
  <Rectangle class="absolute -right-5 bottom-5" />
</section>
