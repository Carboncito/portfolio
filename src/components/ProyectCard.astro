---
import { Image } from 'astro:assets';

interface Props {
  name: string;
  shortDesc: string;
  img: string;
  tools: string[];
  class?: string;
}
const { tools, img, shortDesc, name, class: customClass = '' } = Astro.props;
---

<div
  class={`border-primary-gray/20 group overflow-hidden rounded-t-lg border-2 transition-all duration-300 shadow-lg/20 shadow-primary-gray/50 ${customClass}`}
>
  <div class="relative aspect-video overflow-hidden">
    <Image
      src={img}
      alt={name}
      width={288}
      height={201}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
    />
  </div>
  <div class="border-primary-gray/20 border-t-2 border-b-2 p-2">
    <p class="text-primary-gray flex flex-wrap gap-x-3 text-[16px]">
      {tools.map((tool) => <span>{tool}</span>)}
    </p>
  </div>
  <div class="flex flex-col gap-4 p-4">
    <h3 class="text-2xl font-medium">{name}</h3>
    <p class="text-primary-gray text-[16px]">{shortDesc}</p>
  </div>
</div>
